# Local .terraform directories (contains downloaded providers and modules)
**/.terraform/*

# .tfstate files contain sensitive credentials and environment infrastructure states.
# These should be stored in a secure remote backend (e.g., AWS S3, HashiCorp Cloud), never in Git.
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude all variable files containing sensitive credentials or environment-specific values
#*.tfvars
*.tfvars.json

# Exclude automatically generated override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore terraform plan outputs (can contain sensitive state data)
*tfplan*